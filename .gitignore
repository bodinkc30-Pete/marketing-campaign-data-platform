# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# IDE and editor files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# DB Browser project files
*.sqbpro

# SQLite databases and temporary files
database/*.db
*.db-journal
*.db-shm
*.db-wal

# Raw and sensitive source data
data/raw/

# Staging files containing source-derived records
data/staging/*

# Generated processed data
data/processed/*

# Generated reports
reports/*

# Keep directory structure in Git
!data/processed/.gitkeep
!data/staging/.gitkeep
!reports/.gitkeep

# Allow portfolio-safe report directory
!reports/portfolio_outputs/
reports/portfolio_outputs/*
!reports/portfolio_outputs/*.csv

# Logs
*.log
logs/

# Environment and secrets
.env
.env.*
*.pem
*.key