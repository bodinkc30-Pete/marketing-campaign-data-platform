# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# IDE and editor files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# DB Browser project files
*.sqbpro

# SQLite temporary files
*.db-journal
*.db-shm
*.db-wal

# Raw and sensitive source data
data/raw/

# Staging files containing source-derived records
data/staging/*

# Local database generated by the pipeline
database/*.db

# Generated processed data and reports
data/processed/*
reports/*

# Keep directory structure in Git
!data/processed/.gitkeep
!data/staging/.gitkeep
!reports/.gitkeep

# Logs
*.log
logs/

# Environment and secrets
.env
.env.*
*.pem
*.key